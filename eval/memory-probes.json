{
  "meta": {
    "name": "米粒长期记忆探针（LongMemEval 风格本地化小集）",
    "why": "对标 LongMemEval (ICLR 2025) 五类能力：信息抽取、多会话推理、时序推理、知识更新、弃答。用中文老人真实说法自建，专门测三层记忆的召回与冲突消解，不测模型本身。",
    "rule": "只作不变量校验与回归门禁，不作进化证据；不是赛题考卷，与 eval/heldout.json 分开跑。",
    "method": "把 sessions 依次灌进 MILI_CONTEXT.push() 与 MILI_MEMO.add()，再用 MILI_CONTEXT.retrieve(q,5) 召回，检查 want 是否出现在 top-k；弃答类检查 hasEvidence() 为 false。",
    "metrics": [
      "Recall@5",
      "top1 命中率",
      "弃答正确率",
      "知识更新新值优先率"
    ],
    "source": "自建；题型结构参考 xiaowu0162/LongMemEval，规模远小，只能用作回归门禁，不能对外宣称 benchmark 分数"
  },
  "sessions": [
