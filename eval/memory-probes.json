  "probes": [
    {
      "id": "m1",
      "type": "single-session-user",
      "q": "我女儿叫什么名字",
      "want": "小芳"
    },
    {
      "id": "m2",
      "type": "single-session-user",
      "q": "我女儿在哪个城市上班",
      "want": "天津"
    },
    {
      "id": "m3",
      "type": "single-session-preference",
      "q": "我以前喜欢喝什么茶",
      "want": "花茶"
    },
    {
      "id": "m4",
      "type": "knowledge-update",
      "q": "我现在喝什么茶",
      "want": "乌龙茶"
    },
    {
      "id": "m5",
      "type": "temporal-reasoning",
      "q": "我哪天去医院看的喉咙",
      "want": "2026-11-12"
    },
    {
      "id": "m6",
      "type": "multi-session",
